# Contact address included in the scraper's User-Agent (Wikimedia requires one).
INTELLIGRAPH_CONTACT=your.name@example.com

# Optional: override the repository root used for data/logs/report paths.
# INTELLIGRAPH_ROOT=

# --- Phase 3: retrieval & generation ---------------------------------------
INTELLIGRAPH_PGVECTOR_DSN=postgresql://postgres:pass@localhost:5433/postgres
INTELLIGRAPH_NEO4J_URI=bolt://localhost:7687
INTELLIGRAPH_NEO4J_USER=neo4j
INTELLIGRAPH_NEO4J_PASSWORD=password
INTELLIGRAPH_GEMINI_API_KEY=
INTELLIGRAPH_EMBEDDING_MODEL=all-MiniLM-L6-v2
INTELLIGRAPH_TOP_K=5
