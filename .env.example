# Contact address included in the scraper's User-Agent (Wikimedia requires one).
INTELLIGRAPH_CONTACT=your.name@example.com

# Optional: override the repository root used for data/logs/report paths.
# INTELLIGRAPH_ROOT=

# --- stores ------------------------------------------------------------------
INTELLIGRAPH_PGVECTOR_DSN=postgresql://postgres:pass@localhost:5433/postgres
INTELLIGRAPH_NEO4J_URI=bolt://localhost:7687
INTELLIGRAPH_NEO4J_USER=neo4j
INTELLIGRAPH_NEO4J_PASSWORD=password
INTELLIGRAPH_EMBEDDING_MODEL=all-MiniLM-L6-v2
INTELLIGRAPH_TOP_K=5

# --- LLM (keys go in your private .env only; never commit) ------------------
# Primary: Google AI Studio free tier -> https://aistudio.google.com/apikey
INTELLIGRAPH_LLM_PROVIDER=gemini
INTELLIGRAPH_GEMINI_API_KEY=
# Optional pin; leave empty to auto-pick a model that exists for your key
# INTELLIGRAPH_GEMINI_MODEL=
# INTELLIGRAPH_GEMINI_MODEL_PREFERENCE=
# Optional backup (OpenAI-compatible, e.g. Groq -> https://console.groq.com)
# GROQ_API_KEY=
# INTELLIGRAPH_OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
# INTELLIGRAPH_OPENAI_COMPAT_MODEL=llama-3.1-8b-instant

# --- app --------------------------------------------------------------------
INTELLIGRAPH_MAX_UPLOAD_MB=20
INTELLIGRAPH_FRONTEND_ORIGIN=http://localhost:5173,http://localhost:8080
INTELLIGRAPH_RATE_LIMIT_PER_MIN=120
INTELLIGRAPH_ANSWER_CACHE=0
